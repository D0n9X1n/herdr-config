{
  "global": {
    "cmd-+": "app.zoom_in",
    "cmd-,": "app.settings",
    "cmd--": "app.zoom_out",
    "cmd-/": "app.help",
    "cmd-0": "app.zoom_reset",
    "cmd-1": "tab.select:1",
    "cmd-2": "tab.select:2",
    "cmd-3": "tab.select:3",
    "cmd-4": "tab.select:4",
    "cmd-5": "tab.select:5",
    "cmd-6": "tab.select:6",
    "cmd-7": "tab.select:7",
    "cmd-8": "tab.select:8",
    "cmd-9": "apollo-tabs.last",
    "cmd-=": "app.zoom_in",
    "cmd-]": "agent.next",
    "cmd-alt-[": "space.prev",
    "cmd-alt-]": "space.next",
    "cmd-alt-down": "pane.go:down",
    "cmd-alt-h": "app.hide_others",
    "cmd-alt-l": "layout.switch",
    "cmd-alt-left": "pane.go:left",
    "cmd-alt-right": "pane.go:right",
    "cmd-alt-shift-down": "pane.swap:down",
    "cmd-alt-shift-left": "pane.swap:left",
    "cmd-alt-shift-right": "pane.swap:right",
    "cmd-alt-shift-up": "pane.swap:up",
    "cmd-alt-up": "pane.go:up",
    "cmd-b": "layout.toggle:sidebar",
    "cmd-d": "pane.split:right",
    "cmd-down": {
      "args": {
        "lines": 1
      },
      "command": "terminal.scroll"
    },
    "cmd-end": {
      "args": {
        "to": "bottom"
      },
      "command": "terminal.scroll"
    },
    "cmd-h": "app.hide",
    "cmd-home": {
      "args": {
        "to": "top"
      },
      "command": "terminal.scroll"
    },
    "cmd-left": "tab.prev",
    "cmd-n": "space.new",
    "cmd-p": "mod.open:picker",
    "cmd-pagedown": {
      "args": {
        "pages": 1
      },
      "command": "terminal.scroll"
    },
    "cmd-pageup": {
      "args": {
        "pages": -1
      },
      "command": "terminal.scroll"
    },
    "cmd-q": "app.quit",
    "cmd-right": "tab.next",
    "cmd-shift-/": "app.help",
    "cmd-shift-=": "app.zoom_in",
    "cmd-shift-[": "tab.prev",
    "cmd-shift-]": "tab.next",
    "cmd-shift-d": "pane.split:down",
    "cmd-shift-enter": "pane.zoom",
    "cmd-shift-h": "pane.go:left",
    "cmd-shift-j": "pane.go:down",
    "cmd-shift-k": "pane.go:up",
    "cmd-shift-l": "pane.go:right",
    "cmd-shift-p": "app.palette",
    "cmd-shift-t": "tab.new",
    "cmd-shift-w": "pane.close",
    "cmd-shift-z": "pane.zoom",
    "cmd-t": "tab.new",
    "cmd-up": {
      "args": {
        "lines": -1
      },
      "command": "terminal.scroll"
    },
    "cmd-w": "pane.close",
    "ctrl-1": "space.select:1",
    "ctrl-2": "space.select:2",
    "ctrl-3": "space.select:3",
    "ctrl-4": "space.select:4",
    "ctrl-5": "space.select:5",
    "ctrl-6": "space.select:6",
    "ctrl-7": "space.select:7",
    "ctrl-8": "space.select:8",
    "ctrl-9": "space.select:9",
    "ctrl-shift-tab": "tab.prev",
    "ctrl-tab": "tab.next",
    "f2": "tab.rename",
    "shift-f2": "space.rename"
  },
  "layout:apollo": {
    "cmd-n": "apollo-tabs.space",
    "cmd-shift-t": "apollo-tabs.terminal",
    "cmd-t": "apollo-tabs.terminal"
  },
  "terminal": {
    "alt-backspace": "send:\u0017",
    "alt-left": "send:\u001bb",
    "alt-right": "send:\u001bf",
    "cmd-backspace": "send:\u0015",
    "cmd-c": "terminal.copy",
    "cmd-f": "terminal.search",
    "cmd-left": "tab.prev",
    "cmd-right": "tab.next",
    "cmd-v": "terminal.paste",
    "ctrl-v": "terminal.paste_image"
  }
}
